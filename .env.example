# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server: creazione utenti, reset PIN, cron. Mai esporla al browser.
SUPABASE_SERVICE_ROLE_KEY=

# Indirizzo pubblico del sito (es. https://staff-cordusio.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notifiche push (milestone 11): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email facoltative (milestone 11)
RESEND_API_KEY=
EMAIL_FROM=

# Protegge le rotte /api/cron/*
CRON_SECRET=

# Usati una volta sola da `pnpm seed:admin`
FIRST_ADMIN_CODE=ADM-001
FIRST_ADMIN_PIN=
FIRST_ADMIN_FIRST_NAME=
FIRST_ADMIN_LAST_NAME=
FIRST_ADMIN_DISPLAY_NAME=
